table d_Jogadores
	lineageTag: 2a43beff-3884-4f13-a17c-d74a528158ce

	column id_jogador
		dataType: int64
		formatString: 0
		lineageTag: 87ef54da-e945-41ba-8d9e-a3c7f6080d3a
		summarizeBy: none
