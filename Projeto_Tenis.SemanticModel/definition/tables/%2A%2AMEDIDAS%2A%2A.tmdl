table **MEDIDAS**
	lineageTag: a7762900-28d5-45bd-8147-b328bd097621

	measure '1.Vitorias' =
			
			
			CALCULATE(
			    COUNTROWS(f_Resultados_Gold),
			    KEEPFILTERS(d_PerfilPartida[tipo_termino] <> "W.O."))
		formatString: 0
		displayFolder: 1.Vitorias, Derrotas, Partidas, Titulos
		lineageTag: 218290d8-5f73-4cba-ae32-cf4a57e6e6cc

	measure '2.Derrotas' =
			
			
			CALCULATE(
			    COUNTROWS(f_Resultados_Gold),
			    USERELATIONSHIP(d_Jogadores[id_jogador],f_Resultados_Gold[id_perdedor]),
			    KEEPFILTERS(d_PerfilPartida[tipo_termino] <> "W.O.")
			) + 0
		formatString: 0
		displayFolder: 1.Vitorias, Derrotas, Partidas, Titulos
		lineageTag: f9ad1198-7204-40c8-aff1-e8d109d047ab

	measure '3.Partidas' = ```
			
			    [1.Vitorias] + [2.Derrotas] +0
			```
		formatString: 0
		displayFolder: 1.Vitorias, Derrotas, Partidas, Titulos
		lineageTag: 3212200f-bb33-4a10-82ce-aaee529b40ff

	measure '4.%Vitorias' = ```
			
			
			    DIVIDE([1.Vitorias] + 0, [3.Partidas])
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1.Vitorias, Derrotas, Partidas, Titulos
		lineageTag: 1d520e0b-e581-48dd-b895-37f38eb45084

	measure '5.Títulos' = ```
			
			
			    CALCULATE([1.Vitorias], d_Rodada[rodada] = "F") +0
			```
		formatString: 0
		displayFolder: 1.Vitorias, Derrotas, Partidas, Titulos
		lineageTag: bead5764-cc0e-424a-bd04-a4a52461d1a5

	measure '6. Finais Disputadas' = ```
			
			
			    CALCULATE([3.Partidas], d_Rodada[rodada] = "F")
			    
			```
		formatString: 0
		displayFolder: 1.Vitorias, Derrotas, Partidas, Titulos
		lineageTag: fbf0c36a-cf90-4a42-b5b6-f0b05ea55a92

	measure '1.Mao' =
			
			
			SWITCH(
			    SELECTEDVALUE(d_Jogadores[mao]),
			    "R", "Destro",
			    "L", "Canhoto",
			    "Não informado"
			)
		displayFolder: 2.Atributos Jogador
		lineageTag: 955c8de9-4476-4d8d-91f8-b0ac282be53f

	measure '5.Idade Atual' =
			
			VAR t =
			    UNION (
			        CALCULATETABLE (
			            SELECTCOLUMNS ( f_Resultados_Gold, "d", f_Resultados_Gold[data_torneio], "i", f_Resultados_Gold[idade_vencedor] ),
			            REMOVEFILTERS ( d_Calendario )
			        ),
			        CALCULATETABLE (
			            SELECTCOLUMNS ( f_Resultados_Gold, "d", f_Resultados_Gold[data_torneio], "i", f_Resultados_Gold[idade_perdedor] ),
			            USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] ),
			            REMOVEFILTERS ( d_Calendario )
			        )
			    )
			VAR UltimaData = MAXX ( t, [d] )
			VAR IdadeUltima = MAXX ( FILTER ( t, [d] = UltimaData ), [i] )
			RETURN
			    IF (
			        HASONEVALUE ( d_Jogadores[id_jogador] ),
			        INT ( IdadeUltima + DATEDIFF ( UltimaData, TODAY (), DAY ) / 365.25 )
			    )
		formatString: 0
		displayFolder: 2.Atributos Jogador
		lineageTag: adc1a554-c6c2-4dec-88aa-6eca8c60a653

	measure '01.Aces' =
			
			
			SUM ( f_Resultados_Gold[aces_vencedor] )
			    + CALCULATE ( SUM ( f_Resultados_Gold[aces_perdedor] ), USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor]))
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 18e39e8c-7160-44ab-a92d-ebb37547fe80

	measure '02.Duplas Faltas' =
			
			
			SUM ( f_Resultados_Gold[duplas_faltas_vencedor] )
			    + CALCULATE ( SUM ( f_Resultados_Gold[duplas_faltas_perdedor] ), USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] ) )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 4221deb4-9278-482f-bb70-3e1f196d14d5

	measure '09.Partidas com Estatística' =
			
			
			CALCULATE ( COUNTROWS ( f_Resultados_Gold ), NOT ISBLANK ( f_Resultados_Gold[pontos_saque_vencedor] ) )
			    + CALCULATE (
			        COUNTROWS ( f_Resultados_Gold),
			        NOT ISBLANK ( f_Resultados_Gold[pontos_saque_perdedor] ),
			        USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			    )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 7369923b-fe75-464c-9510-50e436891560

	measure '14.Aces por Partida' =
			
			
			DIVIDE([01.Aces], [09.Partidas com Estatística])
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 87ac5a0a-b5be-4c3d-aa60-0d2c06cd56c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '15.Dupla falta por partida' =
			
			
			DIVIDE([02.Duplas Faltas], [09.Partidas com Estatística])
		displayFolder: 3. Estatisticas Jogador
		lineageTag: cf709b14-be9e-45a3-b6aa-fe82986d7e9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Perfil Jogador' = ```
			
			 " · " &
			[1.Mao] & " · "&
			 SELECTEDVALUE ( d_Jogadores[altura] ) & " cm · " & [5.Idade Atual] & " anos"
			```
		displayFolder: 5.KPI
		lineageTag: a63111e8-8d99-4f37-a3b1-b4060d481303

	measure '1KPI Ranking' =
			
			
			VAR r = SELECTEDVALUE ( d_Top100[ranking_atual] )
			RETURN IF ( NOT ISBLANK ( r ), "#" & r, "—" )
		displayFolder: 5.KPI
		lineageTag: 2c1bf599-c510-4a17-9466-77b9944e9cf9

	measure '2KPI Pontos' =
			
			
			VAR p = SELECTEDVALUE ( d_Top100[pontos_atual] )
			RETURN IF ( NOT ISBLANK ( p ), FORMAT ( p, "#,0" ), "—" )
		displayFolder: 5.KPI
		lineageTag: 00dc3963-44f1-4231-8d6f-45542dea7aa5

	measure 'Melhor Ranking' =
			
			VAR t =
			    UNION (
			        SELECTCOLUMNS ( f_Resultados_Gold, "r", f_Resultados_Gold[ranking_vencedor] ),
			        CALCULATETABLE (
			            SELECTCOLUMNS ( f_Resultados_Gold, "r", f_Resultados_Gold[ranking_perdedor] ),
			            USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			        )
			    )
			VAR MelhorBase = MINX ( t, [r] )
			VAR Atual      = SELECTEDVALUE ( d_Top100[ranking_atual] )
			VAR Melhor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( MelhorBase ), Atual,
			        ISBLANK ( Atual ), MelhorBase,
			        MIN ( MelhorBase, Atual )
			    )
			RETURN
			    IF ( HASONEVALUE ( d_Jogadores[id_jogador] ), Melhor )
		formatString: 0
		displayFolder: 5.KPI
		lineageTag: 5998a35e-3c59-42a2-a548-bc8e0e47bbb0

	measure '4KPI     Retrospecto' =
			
			
			IF ( HASONEVALUE ( d_Jogadores[id_jogador] ), [1.Vitorias] & "V – " & [2.Derrotas] & "D" )
		displayFolder: 5.KPI
		lineageTag: cab685bf-5918-4782-ac63-56576798e620

	measure '1.CARTAO HTML KPIs' =
			
			VAR FonteTexto = "font-family:'Segoe UI',sans-serif;"
			VAR FonteNum   = "font-family:'Segoe UI Semibold','Segoe UI',sans-serif;font-weight:600;"
			
			VAR sRotulo   = FonteTexto & "font-size:13px;color:#767676;letter-spacing:0.6px;text-transform:uppercase;white-space:nowrap;margin-bottom:2px;"
			VAR sValor    = FonteNum & "font-size:36px;color:#333333;line-height:1.1;white-space:nowrap;"
			VAR sDestaque = FonteNum & "font-size:36px;color:#1F4E79;line-height:1.1;white-space:nowrap;"
			VAR sContexto = FonteTexto & "font-size:13px;color:#8A8A8A;white-space:nowrap;margin-top:4px;"
			VAR sColuna   = "flex:1 1 0;min-width:0;padding-right:16px;box-sizing:border-box;"
			
			-- Barra de progresso (o CSS precisa de ponto decimal)
			VAR BarraIni = "<div style=""width:110px;height:5px;background:#E6E6E6;border-radius:3px;margin-top:8px;""><div style=""width:"
			VAR BarraFim = "%;height:5px;background:#C8D646;border-radius:3px;""></div></div>"
			
			-- Espaço com a mesma altura da barra, para alinhar o contexto dos KPIs sem barra
			VAR Espaco = "<div style=""height:5px;margin-top:8px;""></div>"
			
			VAR PctV   = [4.%Vitorias]
			VAR BarraV = BarraIni & SUBSTITUTE ( FORMAT ( PctV * 100, "0.0" ), ",", "." ) & BarraFim
			
			VAR PctTop   = [% Vitórias vs Top 10]
			VAR BarraTop = IF ( ISBLANK ( PctTop ), Espaco, BarraIni & SUBSTITUTE ( FORMAT ( PctTop * 100, "0.0" ), ",", "." ) & BarraFim )
			
			-- Ranking
			VAR C1 =
			    "<div style=""" & sColuna & """>"
			        & "<div style=""" & sRotulo & """>Ranking</div>"
			        & "<div style=""" & sDestaque & """>" & [1KPI Ranking] & "</div>"
			        & Espaco
			        & "<div style=""" & sContexto & """>" & [3KPI Melhor Ranking] & "</div>"
			    & "</div>"
			
			-- Pontos
			VAR C2 =
			    "<div style=""" & sColuna & """>"
			        & "<div style=""" & sRotulo & """>Pontos</div>"
			        & "<div style=""" & sValor & """>" & [2KPI Pontos] & "</div>"
			        & Espaco
			        & "<div style=""" & sContexto & """>em 20/10/2026</div>"
			    & "</div>"
			
			-- Vitórias
			VAR C3 =
			    "<div style=""" & sColuna & """>"
			        & "<div style=""" & sRotulo & """>Vitórias</div>"
			        & "<div style=""" & sValor & """>" & FORMAT ( PctV, "0.0%" ) & "</div>"
			        & BarraV
			        & "<div style=""" & sContexto & """>" & [4KPI     Retrospecto] & "</div>"
			    & "</div>"
			
			-- Títulos
			VAR C4 =
			    "<div style=""" & sColuna & """>"
			        & "<div style=""" & sRotulo & """>Títulos</div>"
			        & "<div style=""" & sValor & """>" & [5.Títulos] & "</div>"
			        & Espaco
			        & "<div style=""" & sContexto & """>de " & [6. Finais Disputadas] & " finais</div>"
			    & "</div>"
			
			-- Vs. Top 10
			VAR C5 =
			    "<div style=""" & sColuna & """>"
			        & "<div style=""" & sRotulo & """>Vs. Top 10</div>"
			        & "<div style=""" & sValor & """>" & IF ( ISBLANK ( PctTop ), "—", FORMAT ( PctTop, "0.0%" ) ) & "</div>"
			        & BarraTop
			        & "<div style=""" & sContexto & """>" & [Vitórias vs Top 10] + 0 & "V – " & [Derrotas vs Top 10] + 0 & "D</div>"
			    & "</div>"
			
			RETURN
			    IF (
			        HASONEVALUE ( d_Jogadores[id_jogador] ),
			        "<div style=""display:flex;align-items:flex-start;padding:8px 12px;"">"
			            & C1 & C2 & C3 & C4 & C5
			        & "</div>"
			    )
		displayFolder: 6.Cartoes HTML
		lineageTag: 7cc42b3b-dafe-41d5-9261-c4182ed09993

	measure '3KPI Melhor Ranking' =
			
			VAR m = [Melhor Ranking]
			RETURN IF ( NOT ISBLANK ( m ), "Melhor: #" & m )
		displayFolder: 5.KPI
		lineageTag: 01944349-b1ff-4bda-aaae-9a2b9612a54f

	measure 'Vitórias vs Top 10' =
			
			CALCULATE (
			    [1.Vitorias],
			    KEEPFILTERS ( f_Resultados_Gold[ranking_perdedor] <= 10 )
			)
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 6ab1a898-99b1-492a-90ed-7429f097cd3c

	measure 'Derrotas vs Top 10' =
			
			CALCULATE (
			    [2.Derrotas],
			    KEEPFILTERS ( f_Resultados_Gold[ranking_vencedor] <= 10 )
			)
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 414bf296-80d4-4d9a-b279-e037ef821106

	measure '% Vitórias vs Top 10' =
			
			DIVIDE (
			    [Vitórias vs Top 10],
			    [Vitórias vs Top 10] + [Derrotas vs Top 10]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Estatisticas Jogador
		lineageTag: c4efafb0-d4ff-44da-91aa-38046f94fb48

	measure 'Aces por Partida (Circuito)' =
			
			CALCULATE ( [14.Aces por Partida], REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
		displayFolder: 3. Estatisticas Jogador
		lineageTag: d1935cc0-3573-442a-a844-20956f3c99a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Duplas Faltas por Partida (Circuito)' =
			
			CALCULATE ( [15.Dupla falta por partida], REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 3feaf109-fcb9-4285-91cc-3a760a1d6d38

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2.CARTAO HTML Jogo' =
			
			VAR FonteTexto = "font-family:'Segoe UI',sans-serif;"
			VAR FonteNum   = "font-family:'Segoe UI Semibold','Segoe UI',sans-serif;font-weight:600;"
			
			VAR sTitulo    = FonteNum & "font-size:17px;color:#333333;"
			VAR sSubtitulo = FonteTexto & "font-size:12px;color:#767676;"
			VAR sSecao     = FonteTexto & "font-size:11px;color:#9A9A9A;letter-spacing:0.8px;text-transform:uppercase;margin:14px 0 6px 0;border-bottom:1px solid #EEEEEE;padding-bottom:4px;"
			VAR sRotulo    = FonteTexto & "font-size:12px;color:#767676;"
			VAR sValor     = FonteNum & "font-size:30px;color:#333333;line-height:1.1;"
			VAR sContexto  = FonteTexto & "font-size:12px;color:#8A8A8A;"
			
			-- ===== Saque: bolinhas =====
			VAR Bola      = "<span style=""display:inline-block;width:13px;height:13px;border-radius:50%;margin-right:4px;background:"
			VAR BolaAce   = Bola & "#C8D646;""></span>"
			VAR BolaDF    = Bola & "#B85C5C;""></span>"
			VAR BolaVazia = Bola & "#E6E6E6;""></span>"
			
			VAR AcesJ = [14.Aces por Partida]
			VAR AcesC = [Aces por Partida (Circuito)]
			VAR DFJ   = [15.Dupla falta por partida]
			VAR DFC   = [Duplas Faltas por Partida (Circuito)]
			
			VAR BolasAces = REPT ( BolaAce, ROUND ( AcesJ, 0 ) ) & REPT ( BolaVazia, MAX ( ROUND ( AcesC, 0 ) - ROUND ( AcesJ, 0 ), 0 ) )
			VAR BolasDF   = REPT ( BolaDF, ROUND ( DFJ, 0 ) ) & REPT ( BolaVazia, MAX ( ROUND ( DFC, 0 ) - ROUND ( DFJ, 0 ), 0 ) )
			
			VAR BlocoAces =
			    "<div style=""flex:1;"">"
			        & "<div style=""" & sRotulo & """>Aces por partida</div>"
			        & "<div style=""" & sValor & """>" & FORMAT ( AcesJ, "0.0" ) & "</div>"
			        & "<div style=""margin:4px 0 3px 0;"">" & BolasAces & "</div>"
			        & "<div style=""" & sContexto & """>Circuito: " & FORMAT ( AcesC, "0.0" ) & "</div>"
			    & "</div>"
			
			VAR BlocoDF =
			    "<div style=""flex:1;"">"
			        & "<div style=""" & sRotulo & """>Duplas faltas por partida</div>"
			        & "<div style=""" & sValor & """>" & FORMAT ( DFJ, "0.0" ) & "</div>"
			        & "<div style=""margin:4px 0 3px 0;"">" & BolasDF & "</div>"
			        & "<div style=""" & sContexto & """>Circuito: " & FORMAT ( DFC, "0.0" ) & "</div>"
			    & "</div>"
			
			-- ===== Confrontos: modelo de linha com barra =====
			VAR Linha =
			    "<div style=""display:flex;align-items:center;margin:7px 0;"">"
			        & "<div style=""width:96px;" & sRotulo & """>%ROTULO%</div>"
			        & "<div style=""flex:1;height:8px;background:#EEEEEE;border-radius:4px;margin-right:10px;"">"
			            & "<div style=""width:%LARG%%;height:8px;background:#1F4E79;border-radius:4px;""></div>"
			        & "</div>"
			        & "<div style=""width:56px;text-align:right;" & FonteNum & "font-size:15px;color:#333333;"">%PCT%</div>"
			        & "<div style=""width:80px;text-align:right;" & sContexto & """>%CTX%</div>"
			    & "</div>"
			
			VAR PctR = [% Vitórias vs Destros]
			VAR PctL = [% Vitórias vs Canhotos]
			VAR Pct3 = [% Vitórias em 3 Sets]
			
			VAR LinhaR =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Linha,
			        "%ROTULO%", "Vs. destros" ),
			        "%LARG%", SUBSTITUTE ( FORMAT ( PctR * 100, "0.0" ), ",", "." ) ),
			        "%PCT%", IF ( ISBLANK ( PctR ), "—", FORMAT ( PctR, "0.0%" ) ) ),
			        "%CTX%", [Vitórias vs Destros] + 0 & "V – " & [Derrotas vs Destros] + 0 & "D" )
			
			VAR LinhaL =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Linha,
			        "%ROTULO%", "Vs. canhotos" ),
			        "%LARG%", SUBSTITUTE ( FORMAT ( PctL * 100, "0.0" ), ",", "." ) ),
			        "%PCT%", IF ( ISBLANK ( PctL ), "—", FORMAT ( PctL, "0.0%" ) ) ),
			        "%CTX%", [Vitórias vs Canhotos] + 0 & "V – " & [Derrotas vs Canhotos] + 0 & "D" )
			
			VAR Linha3 =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Linha,
			        "%ROTULO%", "Em 3 sets" ),
			        "%LARG%", SUBSTITUTE ( FORMAT ( Pct3 * 100, "0.0" ), ",", "." ) ),
			        "%PCT%", IF ( ISBLANK ( Pct3 ), "—", FORMAT ( Pct3, "0.0%" ) ) ),
			        "%CTX%", [Vitórias em 3 Sets] + 0 & "V – " & [Derrotas em 3 Sets] + 0 & "D" )
			
			-- ===== Duração =====
			VAR DurJ = [Duração Média (min)]
			VAR DurC = [Duração Média (min) Circuito]
			VAR TxtJ = INT ( ROUND ( DurJ, 0 ) / 60 ) & "h" & FORMAT ( MOD ( ROUND ( DurJ, 0 ), 60 ), "00" )
			VAR TxtC = INT ( ROUND ( DurC, 0 ) / 60 ) & "h" & FORMAT ( MOD ( ROUND ( DurC, 0 ), 60 ), "00" )
			
			VAR BlocoDuracao =
			    "<div style=""display:flex;align-items:baseline;gap:10px;"">"
			        & "<div style=""" & sValor & "font-size:26px;"">" & TxtJ & "</div>"
			        & "<div style=""" & sContexto & """>por partida · circuito: " & TxtC & "</div>"
			    & "</div>"
			
			RETURN
			    IF (
			        HASONEVALUE ( d_Jogadores[id_jogador] ),
			        "<div style=""padding:6px 10px;"">"
			            & "<div style=""" & sTitulo & """>Jogo em números</div>"
			            & "<div style=""" & sSubtitulo & """>Média por partida e desempenho por tipo de confronto</div>"
			            & "<div style=""" & sSecao & """>Saque</div>"
			            & "<div style=""display:flex;gap:16px;"">" & BlocoAces & BlocoDF & "</div>"
			            & "<div style=""" & sSecao & """>% de vitórias por confronto</div>"
			            & LinhaR & LinhaL & Linha3
			            & "<div style=""" & sSecao & """>Duração</div>"
			            & BlocoDuracao
			        & "</div>"
			    )
		displayFolder: 6.Cartoes HTML
		lineageTag: 054db2f6-b9e1-437f-a3a7-a8504e83d979

	measure 'Vitórias em 3 Sets' =
			
			CALCULATE ( [1.Vitorias], d_PerfilPartida[tipo_termino] = "Normal", d_PerfilPartida[num_sets] = 3 )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 9c1e6718-bebc-47bf-931c-3ebb980945ff

	measure 'Derrotas em 3 Sets' =
			
			CALCULATE ( [2.Derrotas], d_PerfilPartida[tipo_termino] = "Normal", d_PerfilPartida[num_sets] = 3 )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 59503ec2-520f-4169-8d2f-3f1ef854494c

	measure '% Vitórias em 3 Sets' =
			
			DIVIDE ( [Vitórias em 3 Sets], [Vitórias em 3 Sets] + [Derrotas em 3 Sets] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 7a28af96-c219-4bce-9eea-2e3017165eca

	measure 'Minutos Jogados' =
			
			SUM ( f_Resultados_Gold[minutos] )
			    + CALCULATE ( SUM ( f_Resultados_Gold[minutos] ), USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] ) )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: bdfc4e3d-7a13-4870-aee9-235d0535292e

	measure 'Partidas com Duração' =
			
			CALCULATE ( COUNTROWS ( f_Resultados_Gold ), NOT ISBLANK ( f_Resultados_Gold[minutos] ) )
			    + CALCULATE (
			        COUNTROWS ( f_Resultados_Gold ),
			        NOT ISBLANK ( f_Resultados_Gold[minutos] ),
			        USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			    )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 31e5f3c3-233e-4ab0-9573-c31e7ab13e5c

	measure 'Duração Média (min)' =
			
			
			DIVIDE ( [Minutos Jogados], [Partidas com Duração] )
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 907cf396-f45f-4711-bc13-f1f8f26ea234

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Duração Média (min) Circuito' =
			
