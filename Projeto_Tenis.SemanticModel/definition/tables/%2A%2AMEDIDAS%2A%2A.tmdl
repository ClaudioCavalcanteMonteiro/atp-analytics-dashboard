	measure '3.RADAR SVG' =
			
			VAR vMin = 0.30
			VAR vMax = 0.80
			VAR R    = 110
			VAR CX   = 230
			VAR CY   = 192
			
			-- Valores do jogador
			VAR J1 = [% 1º Saque]
			VAR J2 = [% Pontos Ganhos 1º Saque]
			VAR J3 = [% Pontos Ganhos 2º Saque]
			VAR J4 = [% BP Salvos]
			VAR J5 = [% Pontos Ganhos na Devolução]
			VAR J6 = [% BP Convertidos]
			
			-- Valores do circuito (sem o filtro do jogador)
			VAR C1 = CALCULATE ( [% 1º Saque],                   REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
			VAR C2 = CALCULATE ( [% Pontos Ganhos 1º Saque],     REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
			VAR C3 = CALCULATE ( [% Pontos Ganhos 2º Saque],     REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
			VAR C4 = CALCULATE ( [% BP Salvos],                  REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
			VAR C5 = CALCULATE ( [% Pontos Ganhos na Devolução], REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
			VAR C6 = CALCULATE ( [% BP Convertidos],             REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) )
			
			-- Os 6 eixos: ângulo, rótulo e valores
			VAR Eixos =
			    ADDCOLUMNS (
			        SELECTCOLUMNS ( GENERATESERIES ( 0, 5, 1 ), "@i", [Value] ),
			        "@ang", RADIANS ( -90 + 60 * [@i] ),
			        "@lab", SWITCH ( [@i], 0, "1º saque", 1, "Pts 1º saque", 2, "Pts 2º saque", 3, "BP salvos", 4, "Pts devolução", 5, "BP convertidos" ),
			        "@j",   SWITCH ( [@i], 0, J1, 1, J2, 2, J3, 3, J4, 4, J5, 5, J6 ),
			        "@c",   SWITCH ( [@i], 0, C1, 1, C2, 2, C3, 3, C4, 4, C5, 5, C6 )
			    )
			
			-- Distância do centro (limitada entre vMin e vMax)
			VAR Raios =
			    ADDCOLUMNS (
			        Eixos,
			        "@rj", R * MAX ( 0, MIN ( 1, DIVIDE ( [@j] - vMin, vMax - vMin ) ) ),
			        "@rc", R * MAX ( 0, MIN ( 1, DIVIDE ( [@c] - vMin, vMax - vMin ) ) )
			    )
			
			-- Coordenadas em texto, com ponto decimal (o SVG não aceita vírgula)
			VAR Coords =
			    ADDCOLUMNS (
			        Raios,
			        "@xj", SUBSTITUTE ( FORMAT ( CX + [@rj] * COS ( [@ang] ), "0.0" ), ",", "." ),
			        "@yj", SUBSTITUTE ( FORMAT ( CY + [@rj] * SIN ( [@ang] ), "0.0" ), ",", "." ),
			        "@xc", SUBSTITUTE ( FORMAT ( CX + [@rc] * COS ( [@ang] ), "0.0" ), ",", "." ),
			        "@yc", SUBSTITUTE ( FORMAT ( CY + [@rc] * SIN ( [@ang] ), "0.0" ), ",", "." ),
			        "@xr", SUBSTITUTE ( FORMAT ( CX + R * COS ( [@ang] ), "0.0" ), ",", "." ),
			        "@yr", SUBSTITUTE ( FORMAT ( CY + R * SIN ( [@ang] ), "0.0" ), ",", "." ),
			        "@xl", SUBSTITUTE ( FORMAT ( CX + ( R + 30 ) * COS ( [@ang] ), "0.0" ), ",", "." ),
			        "@yl1", SUBSTITUTE ( FORMAT ( CY + ( R + 30 ) * SIN ( [@ang] ) - 4, "0.0" ), ",", "." ),
			        "@yl2", SUBSTITUTE ( FORMAT ( CY + ( R + 30 ) * SIN ( [@ang] ) + 12, "0.0" ), ",", "." ),
			        "@anc", IF ( ABS ( COS ( [@ang] ) ) < 0.2, "middle", IF ( COS ( [@ang] ) > 0, "start", "end" ) )
			    )
			
			-- Grade: hexágonos de 40% a 80%
			VAR Grade =
			    CONCATENATEX (
			        SELECTCOLUMNS ( GENERATESERIES ( 4, 8, 1 ), "@n", [Value] ),
			        "<polygon points='"
			            & CONCATENATEX (
			                Eixos,
			                SUBSTITUTE ( FORMAT ( CX + R * ( [@n] / 10 - vMin ) / ( vMax - vMin ) * COS ( [@ang] ), "0.0" ), ",", "." )
			                    & ","
			                    & SUBSTITUTE ( FORMAT ( CY + R * ( [@n] / 10 - vMin ) / ( vMax - vMin ) * SIN ( [@ang] ), "0.0" ), ",", "." ),
			                " ", [@i], ASC
			            )
			            & "' fill='none' stroke='%23E6E6E6' stroke-width='1'/>",
			        ""
			    )
			
			-- Linhas do centro até as pontas
			VAR EixosLinhas =
			    CONCATENATEX ( Coords, "<line x1='" & CX & "' y1='" & CY & "' x2='" & [@xr] & "' y2='" & [@yr] & "' stroke='%23EEEEEE'/>", "" )
			
			VAR PolyC = CONCATENATEX ( Coords, [@xc] & "," & [@yc], " ", [@i], ASC )
			VAR PolyJ = CONCATENATEX ( Coords, [@xj] & "," & [@yj], " ", [@i], ASC )
			
			VAR Marcadores =
			    CONCATENATEX ( Coords, "<circle cx='" & [@xj] & "' cy='" & [@yj] & "' r='3.5' fill='%231F4E79'/>", "" )
			
			VAR Rotulos =
			    CONCATENATEX (
			        Coords,
			        "<text x='" & [@xl] & "' y='" & [@yl1] & "' text-anchor='" & [@anc] & "' font-size='12' fill='%23767676'>" & [@lab] & "</text>"
			            & "<text x='" & [@xl] & "' y='" & [@yl2] & "' text-anchor='" & [@anc] & "' font-size='14' font-weight='600' fill='%231F4E79'>"
			            & SUBSTITUTE ( FORMAT ( [@j], "0.0%" ), "%", "%25" ) & "</text>",
			        ""
			    )
			
			VAR Legenda =
			    "<line x1='150' y1='362' x2='172' y2='362' stroke='%231F4E79' stroke-width='2.5'/>"
			        & "<text x='178' y='366' font-size='11' fill='%23767676'>Jogador</text>"
			        & "<line x1='250' y1='362' x2='272' y2='362' stroke='%239A9A9A' stroke-width='1.5' stroke-dasharray='4 3'/>"
			        & "<text x='278' y='366' font-size='11' fill='%23767676'>Circuito</text>"
			
			VAR SVG =
			    "data:image/svg+xml;utf8,"
			        & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 460 380' width='460' height='380' font-family='Segoe UI, sans-serif'>"
			        & Grade
			        & EixosLinhas
			        & "<polygon points='" & PolyC & "' fill='none' stroke='%239A9A9A' stroke-width='1.5' stroke-dasharray='4 3'/>"
			        & "<polygon points='" & PolyJ & "' fill='%231F4E79' fill-opacity='0.12' stroke='%231F4E79' stroke-width='2.5'/>"
			        & Marcadores
			        & Rotulos
			        & Legenda
			        & "</svg>"
			
			RETURN
			    IF ( HASONEVALUE ( d_Jogadores[id_jogador] ), SVG )
		displayFolder: 6.Cartoes HTML
		lineageTag: 1e84330c-3050-4047-89e4-84c6436290c0
		dataCategory: ImageUrl

	measure '4.RADAR HTML' =
			
			VAR FonteTexto = "font-family:'Segoe UI',sans-serif;"
			VAR FonteNum   = "font-family:'Segoe UI Semibold','Segoe UI',sans-serif;font-weight:600;"
			
			VAR sTitulo    = FonteNum & "font-size:17px;color:#333333;"
			VAR sSubtitulo = FonteTexto & "font-size:12px;color:#767676;margin-bottom:6px;"
			
			-- Quantos indicadores estão acima da média do circuito
			VAR Acima =
			    ( [% 1º Saque]                   > CALCULATE ( [% 1º Saque],                   REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) ) )
			    + ( [% Pontos Ganhos 1º Saque]     > CALCULATE ( [% Pontos Ganhos 1º Saque],     REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) ) )
			    + ( [% Pontos Ganhos 2º Saque]     > CALCULATE ( [% Pontos Ganhos 2º Saque],     REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) ) )
			    + ( [% BP Salvos]                  > CALCULATE ( [% BP Salvos],                  REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) ) )
			    + ( [% Pontos Ganhos na Devolução] > CALCULATE ( [% Pontos Ganhos na Devolução], REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) ) )
			    + ( [% BP Convertidos]             > CALCULATE ( [% BP Convertidos],             REMOVEFILTERS ( d_Jogadores ), REMOVEFILTERS ( d_Top100 ) ) )
			
			VAR Subtitulo = "Jogador vs. média do circuito · acima da média em " & Acima & " de 6 indicadores"
			
			RETURN
			    IF (
			        HASONEVALUE ( d_Jogadores[id_jogador] ),
			        "<div style=""padding:6px 10px;"">"
			            & "<div style=""" & sTitulo & """>Perfil de saque e devolução</div>"
			            & "<div style=""" & sSubtitulo & """>" & Subtitulo & "</div>"
			            & "<img src=""" & [3.RADAR SVG] & """ style=""width:100%;height:auto;"">"
			        & "</div>"
			    )
		displayFolder: 6.Cartoes HTML
		lineageTag: 3629e497-8cc9-4555-99e0-1764dc87539a

	measure '5.HTML Superficies' =
			
			VAR FonteTexto = "font-family:'Segoe UI',sans-serif;"
			VAR FonteNum   = "font-family:'Segoe UI Semibold','Segoe UI',sans-serif;font-weight:600;"
			
			VAR sTitulo    = FonteNum & "font-size:17px;color:#333333;"
			VAR sSubtitulo = FonteTexto & "font-size:12px;color:#767676;"
			VAR sRotulo    = FonteTexto & "font-size:12px;color:#767676;letter-spacing:0.6px;text-transform:uppercase;"
			VAR sValor     = FonteNum & "font-size:28px;color:#333333;line-height:1.1;"
			VAR sDestaque  = FonteNum & "font-size:28px;color:#1F4E79;line-height:1.1;"
			VAR sContexto  = FonteTexto & "font-size:12px;color:#8A8A8A;"
			VAR AlturaQuadras = 220   -- espaço reservado para as quadras
			
			-- Desempenho por piso (ignora o clique nas quadras, para mostrar sempre os três)
			VAR PctH = CALCULATE ( [4.%Vitorias], d_Torneios[superficie] = "Hard" )
			VAR PctC = CALCULATE ( [4.%Vitorias], d_Torneios[superficie] = "Clay" )
			VAR PctG = CALCULATE ( [4.%Vitorias], d_Torneios[superficie] = "Grass" )
			VAR RecH = CALCULATE ( [1.Vitorias], d_Torneios[superficie] = "Hard" ) + 0 & "V – " & CALCULATE ( [2.Derrotas], d_Torneios[superficie] = "Hard" ) + 0 & "D"
			VAR RecC = CALCULATE ( [1.Vitorias], d_Torneios[superficie] = "Clay" ) + 0 & "V – " & CALCULATE ( [2.Derrotas], d_Torneios[superficie] = "Clay" ) + 0 & "D"
			VAR RecG = CALCULATE ( [1.Vitorias], d_Torneios[superficie] = "Grass" ) + 0 & "V – " & CALCULATE ( [2.Derrotas], d_Torneios[superficie] = "Grass" ) + 0 & "D"
			
			-- Destaque: a quadra clicada; sem clique, o melhor piso
			VAR Melhor =
			    SWITCH ( TRUE (),
			        PctG >= PctH && PctG >= PctC, "Grass",
			        PctC >= PctH, "Clay",
			        "Hard"
			    )
			VAR Destaque =
			    IF ( ISFILTERED ( d_Torneios[superficie] ), SELECTEDVALUE ( d_Torneios[superficie] ), Melhor )
			
			-- Modelo de coluna
			VAR Coluna =
			    "<div style=""flex:1;text-align:center;"">"
			        & "<div style=""" & sRotulo & """>%NOME%</div>"
			        & "<div style=""%ESTILO%"">%PCT%</div>"
			        & "<div style=""" & sContexto & """>%REC%</div>"
			        & "<div style=""width:72px;height:4px;border-radius:2px;margin:6px auto 0 auto;background:%BARRA%;""></div>"
			    & "</div>"
			
			VAR ColH = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Coluna,
			    "%NOME%", "Dura" ),
			    "%ESTILO%", IF ( Destaque = "Hard", sDestaque, sValor ) ),
			    "%PCT%", IF ( ISBLANK ( PctH ), "—", FORMAT ( PctH, "0.0%" ) ) ),
			    "%REC%", RecH ),
			    "%BARRA%", IF ( Destaque = "Hard", "#C8D646", "transparent" ) )
			
			VAR ColC = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Coluna,
			    "%NOME%", "Saibro" ),
			    "%ESTILO%", IF ( Destaque = "Clay", sDestaque, sValor ) ),
			    "%PCT%", IF ( ISBLANK ( PctC ), "—", FORMAT ( PctC, "0.0%" ) ) ),
			    "%REC%", RecC ),
			    "%BARRA%", IF ( Destaque = "Clay", "#C8D646", "transparent" ) )
			
			VAR ColG = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Coluna,
			    "%NOME%", "Grama" ),
			    "%ESTILO%", IF ( Destaque = "Grass", sDestaque, sValor ) ),
			    "%PCT%", IF ( ISBLANK ( PctG ), "—", FORMAT ( PctG, "0.0%" ) ) ),
			    "%REC%", RecG ),
			    "%BARRA%", IF ( Destaque = "Grass", "#C8D646", "transparent" ) )
			
			RETURN
			    IF (
			        HASONEVALUE ( d_Jogadores[id_jogador] ),
			        "<div style=""padding:6px 10px;"">"
			            & "<div style=""" & sTitulo & """>Desempenho por superfície</div>"
			            & "<div style=""" & sSubtitulo & """>Clique em uma quadra para filtrar a página</div>"
			            & "<div style=""height:" & AlturaQuadras & "px;""></div>"
			            & "<div style=""display:flex;"">" & ColH & ColC & ColG & "</div>"
			        & "</div>"
			    )
		displayFolder: 6.Cartoes HTML
		lineageTag: 2796581e-adf8-4ffc-8841-87230fcf0d6a

	measure '% Pontos Ganhos no Saque' =
			
			DIVIDE (
			    [Pontos Ganhos 1º Saque] + [Pontos Ganhos 2º Saque],
			    [Pontos disputados no saque]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 3d921ae3-7ba2-4889-8f01-f8f32247c72d

	measure 'Trajetoria Ano' =
			
			SWITCH (
			    SELECTEDVALUE ( d_MetricaTrajetoria[metrica], "Vitórias" ),
			    "Vitórias",       [1.Vitorias],
			    "% Vitórias",     [4.%Vitorias],
			    "% Pts no saque", [% Pontos Ganhos no Saque],
			    "Aces/partida",   [14.Aces por Partida]
			)
		lineageTag: 516a54fd-6806-46c9-8a45-de3dee32c190

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( d_MetricaTrajetoria[metrica], "Vitórias" ),
				    "Vitórias",       "#,0",
				    "% Vitórias",     "0.0%",
				    "% Pts no saque", "0.0%",
				    "Aces/partida",   "0.0"
				)

	measure 'Trajetoria Acumulado' =
			
			VAR DataFinal = MAX ( d_Calendario[Data] )
			VAR Estreia =
			    MIN (
			        CALCULATE ( MIN ( f_Resultados_Gold[data_torneio] ), REMOVEFILTERS ( d_Calendario ) ),
			        CALCULATE (
			            MIN ( f_Resultados_Gold[data_torneio] ),
			            USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] ),
			            REMOVEFILTERS ( d_Calendario )
			        )
			    )
			RETURN
			    IF (
			        DataFinal >= Estreia,
			        CALCULATE (
			            [Trajetoria Ano],
			            REMOVEFILTERS ( d_Calendario ),
			            d_Calendario[Data] <= DataFinal
			        )
			    )
		lineageTag: 86f29b72-9d74-46ce-a421-98ec6c2be4ac

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( d_MetricaTrajetoria[metrica], "Vitórias" ),
				    "Vitórias",       "#,0",
				    "% Vitórias",     "0.0%",
				    "% Pts no saque", "0.0%",
				    "Aces/partida",   "0.0"
				)

	measure 'Titulo Trajetoria' =
			
			VAR Metrica = SELECTEDVALUE ( d_MetricaTrajetoria[metrica], "Vitórias" )
			VAR Anos =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( d_Calendario[Ano] ), "@v", [Trajetoria Ano], "@p", [3.Partidas] ),
			        NOT ISBLANK ( [@v] ) && [@p] >= 10
			    )
			VAR Melhor   = TOPN ( 1, Anos, [@v], DESC )
			VAR AnoTop   = MAXX ( Melhor, d_Calendario[Ano] )
			VAR ValorTop = MAXX ( Melhor, [@v] )
			VAR ValorTxt =
			    SWITCH (
			        Metrica,
			        "Vitórias",       FORMAT ( ValorTop, "#,0" ) & " vitórias",
			        "% Vitórias",     FORMAT ( ValorTop, "0.0%" ) & " de vitórias",
			        "% Pts no saque", FORMAT ( ValorTop, "0.0%" ) & " dos pontos no saque",
			        "Aces/partida",   FORMAT ( ValorTop, "0.0" ) & " aces por partida"
			    )
			RETURN
			    IF (
			        ISEMPTY ( Anos ),
			        Metrica & " por temporada",
			        "Melhor temporada: " & AnoTop & ", com " & ValorTxt
			    )
		lineageTag: c55d69fe-c132-4176-afe2-845e1232689e

	measure 'Subtitulo Trajetoria' =
			
			SWITCH (
			    SELECTEDVALUE ( d_MetricaTrajetoria[metrica], "Vitórias" ),
			    "Vitórias",       "Barras: vitórias no ano · Linha: total acumulado desde 2015",
			    "% Vitórias",     "Barras: % no ano · Linha: % acumulado da carreira até o ano",
			    "% Pts no saque", "Barras: % no ano · Linha: % acumulado da carreira até o ano",
			    "Aces/partida",   "Barras: média no ano · Linha: média da carreira até o ano"
			)
		lineageTag: d58c2531-24ed-497f-bd9a-fb14d4f91a24

	measure '5.HTML Titulo Trajetoria' =
			
			"<div style=""padding:6px 10px;"">"
			    & "<div style=""font-family:'Segoe UI Semibold','Segoe UI',sans-serif;font-weight:600;font-size:17px;color:#333333;"">" & [Titulo Trajetoria] & "</div>"
			    & "<div style=""font-family:'Segoe UI',sans-serif;font-size:12px;color:#767676;"">" & [Subtitulo Trajetoria] & "</div>"
			& "</div>"
		lineageTag: 86acf558-9c5b-4e01-a332-f36617c2ab13

	partition **MEDIDAS** = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Colunas Removidas" = Table.RemoveColumns(Fonte,{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

