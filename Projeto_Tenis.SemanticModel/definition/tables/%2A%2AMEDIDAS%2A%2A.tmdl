	measure 'Pontos Disputados na Devolução' =
			
			SUM ( f_Resultados_Gold[pontos_saque_perdedor] )
			    + CALCULATE (
			        SUM ( f_Resultados_Gold[pontos_saque_vencedor] ),
			        USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			    )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 92da2e89-4500-4428-8ecd-1b1ad3798816

	measure 'Pontos Ganhos na Devolução' =
			
			(
			    SUM ( f_Resultados_Gold[pontos_saque_perdedor] )
			        - SUM ( f_Resultados_Gold[pontos_ganhos_primeiro_saque_perdedor] )
			        - SUM ( f_Resultados_Gold[pontos_ganhos_segundo_saque_perdedor] )
			)
			    + CALCULATE (
			        SUM ( f_Resultados_Gold[pontos_saque_vencedor] )
			            - SUM ( f_Resultados_Gold[pontos_ganhos_primeiro_saque_vencedor] )
			            - SUM ( f_Resultados_Gold[pontos_ganhos_segundo_saque_vencedor] ),
			        USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			    )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: 6e7671b8-f34e-4d90-9678-fabc1183b714

	measure 'BP Oportunidades' =
			
			SUM ( f_Resultados_Gold[break_points_enfrentados_perdedor] )
			    + CALCULATE (
			        SUM ( f_Resultados_Gold[break_points_enfrentados_vencedor] ),
			        USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			    )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: fa6265b5-020a-4395-8c95-43a28e631357

	measure 'BP Convertidos' =
			
			(
			    SUM ( f_Resultados_Gold[break_points_enfrentados_perdedor] )
			        - SUM ( f_Resultados_Gold[break_points_salvos_perdedor] )
			)
			    + CALCULATE (
			        SUM ( f_Resultados_Gold[break_points_enfrentados_vencedor] )
			            - SUM ( f_Resultados_Gold[break_points_salvos_vencedor] ),
			        USERELATIONSHIP ( d_Jogadores[id_jogador], f_Resultados_Gold[id_perdedor] )
			    )
		formatString: 0
		displayFolder: 3. Estatisticas Jogador
		lineageTag: dd57d307-70f1-446f-97af-314859c0bd33

