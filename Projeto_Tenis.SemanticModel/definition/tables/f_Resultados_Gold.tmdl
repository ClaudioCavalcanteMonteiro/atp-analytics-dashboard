	column set_decisivo
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: c8d2917c-5f56-4bf6-98af-ea53f32ed516
		summarizeBy: none
		sourceColumn: set_decisivo

		annotation SummarizationSetBy = Automatic

	partition f_Resultados_Gold = m
		mode: import
		queryGroup: Gold
		source =
				let
				    Origem = f_Resultados_Silver,
				
				    // 1. Chave única da partida
				    #"Id partida" = Table.AddColumn(
				        Origem,
				        "id_partida",
				        each [id_torneio] & "-" & Text.From([num_partida]),
				        type text
				    ),
				
				    // 2. Partida decidida no último set possível (3º em melhor de 3, 5º em melhor de 5)
				    #"Set decisivo" = Table.AddColumn(
				        #"Id partida",
				        "set_decisivo",
				        each [tipo_termino] = "Normal" and [num_sets] = [melhor_de],
				        type logical
				    ),
				
				    // 3. Manter apenas chaves, atributos da partida e métricas
				    ColunasFato = {
				        // Chaves
				        "id_partida", "id_torneio", "data_torneio", "rodada", "id_perfil_partida",
				        "id_vencedor", "id_perdedor",
				
				        // Partida
				        "placar", "minutos", "melhor_de", "set_decisivo",
				
				        // Contexto do vencedor na partida
				        "idade_vencedor", "ranking_vencedor", "pontos_ranking_vencedor",
				        "cabeca_chave_vencedor", "entrada_vencedor", "mao_vencedor",
				
				        // Contexto do perdedor na partida
				        "idade_perdedor", "ranking_perdedor", "pontos_ranking_perdedor",
				        "cabeca_chave_perdedor", "entrada_perdedor", "mao_perdedor",
				
				        // Estatísticas do vencedor
				        "aces_vencedor", "duplas_faltas_vencedor", "pontos_saque_vencedor",
				        "primeiro_saque_dentro_vencedor", "pontos_ganhos_primeiro_saque_vencedor",
				        "pontos_ganhos_segundo_saque_vencedor", "games_saque_vencedor",
				        "break_points_salvos_vencedor", "break_points_enfrentados_vencedor",
				
				        // Estatísticas do perdedor
				        "aces_perdedor", "duplas_faltas_perdedor", "pontos_saque_perdedor",
				        "primeiro_saque_dentro_perdedor", "pontos_ganhos_primeiro_saque_perdedor",
				        "pontos_ganhos_segundo_saque_perdedor", "games_saque_perdedor",
				        "break_points_salvos_perdedor", "break_points_enfrentados_perdedor"
				    },
				    #"Colunas da fato" = Table.SelectColumns(#"Set decisivo", ColunasFato),
				
				    // 4. Tipagem final explícita
				    ColunasTexto = {
				        "id_partida", "id_torneio", "rodada", "id_perfil_partida", "placar",
				        "entrada_vencedor", "entrada_perdedor", "mao_vencedor", "mao_perdedor"
				    },
				    ColunasDecimal = {"idade_vencedor", "idade_perdedor"},
				    ColunasData    = {"data_torneio"},
				    ColunasLogico  = {"set_decisivo"},
				    ColunasInteiro = List.Difference(ColunasFato, ColunasTexto & ColunasDecimal & ColunasData & ColunasLogico),
				
				    Tipos =
				        List.Transform(ColunasTexto,   each {_, type text})
				        & List.Transform(ColunasInteiro, each {_, Int64.Type})
				        & List.Transform(ColunasDecimal, each {_, type number})
				        & List.Transform(ColunasData,    each {_, type date})
				        & List.Transform(ColunasLogico,  each {_, type logical}),
				
				    #"Tipos ajustados" = Table.TransformColumnTypes(#"Colunas da fato", Tipos)
				in
				    #"Tipos ajustados"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

