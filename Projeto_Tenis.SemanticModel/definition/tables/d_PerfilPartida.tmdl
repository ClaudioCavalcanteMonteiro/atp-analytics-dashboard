	partition d_PerfilPartida = m
		mode: import
		queryGroup: Gold
		source =
				let
				    Origem = f_Resultados_Silver,
				    #"Escolher colunas" = Table.SelectColumns(Origem, {"id_perfil_partida", "tipo_termino", "num_sets", "num_tiebreaks"}),
				    #"Perfis únicos" = Table.Distinct(#"Escolher colunas", {"id_perfil_partida"}),
