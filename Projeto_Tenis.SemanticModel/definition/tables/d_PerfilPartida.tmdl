				    #"Ordem termino" = Table.AddColumn(#"Sets descricao", "ordem_termino", each
				        Record.FieldOrDefault([Normal = 1, Abandono = 2, #"W.O." = 3, #"Desclassificação" = 4], [tipo_termino], 99), Int64.Type),
				    #"Partida completa" = Table.AddColumn(#"Ordem termino", "partida_completa", each if [tipo_termino] = "Normal" then "Sim" else "Não", type text)
				in
